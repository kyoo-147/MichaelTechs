---
// First-visit prompt pointing readers to the minimal version of the site.
// The body text is the author's own copy, reproduced without omissions.
// Shown once per browser, remembered in localStorage.

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;

const link =
  '<a class="svp-link" href="https://michaeltechs.xyz/all-about-me">https://michaeltechs.xyz/all-about-me</a>';

const copy = {
  en: {
    kicker: "A small notice",
    paragraphs: [
      `If you prefer a minimalist aesthetic, take a look at my <strong>stripped-back version</strong> here: ${link}.`,
      `Personally, I’m a big fan of this minimalist approach. It’s clean and highly efficient. I tend to dislike websites that are overly flashy or cluttered with unnecessary effects.`,
      `While both versions are kept in sync, I primarily post my blog updates and the latest information on the minimalist site; I’d actually <strong>recommend</strong> checking that one out.`,
      `I’ve considered phasing out this current version entirely in favor of the minimalist one, but some friends and colleagues have mentioned that they actually prefer this current design. So, I’ll keep both options available. Feel free to choose whichever one you find more visually appealing.`,
      `Everything here is open-source; I’ve built this using <strong>Astro</strong>, which is incredibly well-optimized and impressively fast. The choice is yours. Have a wonderful day!`,
    ],
    primary: "Open the simple version",
    secondary: "Stay here",
  },
  vi: {
    kicker: "một chút thông báo nhỏ",
    paragraphs: [
      `Nếu bạn là người thích sự tối giản, hãy ghé qua <strong>phiên bản tối giản nhất</strong> để xem nhé: ${link}.`,
      `Cá nhân tôi rất thích phiên bản tối giản, vì nó dễ nhìn và tối ưu với tôi, tôi thường dị ứng với những website quá màu mè và có quá nhiều các hiệu ứng không cần thiết.`,
      `Mặc dù tại trang này và phiên bản đơn giản, cả hai đều đồng bộ, nhưng tôi thường active và sẽ up blog và các thông tin mới nhất trên trang đơn giản trước, vì thế tôi vẫn <strong>high recommend</strong> bạn hãy ghé trang đơn giản.`,
      `Tôi có dự định sẽ bỏ hoàn toàn trang này trong tương lai để chuyển về trang đơn giản luôn, nhưng có một số cá nhân và đồng nghiệp góp ý với tôi, rằng họ cũng thích bản hiện tại hơn, thế nên tôi sẽ để 2 options nhé, cứ chọn cái bạn thấy dễ nhìn.`,
      `Mọi thứ đều là opensource, tôi khá ủng hộ việc sử dụng <strong>astro</strong>, nó tối ưu thật tốt và tốc độ thật đáng kinh ngạc, mọi thứ đều do bạn quyết định nhé, chúc bạn có một ngày tốt lành nhé!`,
    ],
    primary: "Mở bản tối giản",
    secondary: "Ở lại trang này",
  },
} as const;

const text = locale === "vi" ? copy.vi : copy.en;
---

<div id="simple-prompt" class="svp" hidden>
  <div class="svp-card" role="dialog" aria-modal="true" aria-labelledby="svp-kicker">
    <p class="svp-kicker" id="svp-kicker">{text.kicker}</p>
    {text.paragraphs.map(paragraph => <p set:html={paragraph} />)}
    <div class="svp-actions">
      <a class="svp-primary" href="/all-about-me">
        {text.primary} <span aria-hidden="true">&rarr;</span>
      </a>
      <button class="svp-secondary" type="button" data-svp-close>{text.secondary}</button>
    </div>
  </div>
</div>

<style>
  .svp {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(35, 32, 28, 0.38);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .svp.is-open {
    opacity: 1;
  }

  .svp-card {
    width: min(540px, 100%);
    max-height: min(86vh, 780px);
    overflow-y: auto;
    padding: 26px 28px 24px;
    background: #f7f2e4;
    border: 1px solid var(--border, #d3c9b1);
    border-radius: 4px;
    box-shadow: 0 24px 60px -24px rgba(53, 40, 25, 0.45);
    color: var(--foreground, #23201c);
    transform: translateY(8px);
    transition: transform 160ms ease;
  }

  .svp.is-open .svp-card {
    transform: translateY(0);
  }

  .svp-kicker {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--foreground, #23201c);
  }

  .svp-card p {
    margin: 0 0 13px;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--muted-foreground, #6e6a5f);
  }

  :global(.svp-link) {
    color: #2d5285;
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }

  :global(.svp-link:hover) {
    color: #24426b;
  }

  :global(#simple-prompt strong) {
    font-weight: 600;
    color: var(--foreground, #23201c);
  }

  .svp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding-top: 4px;
  }

  .svp-primary,
  .svp-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 3px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .svp-primary {
    background: #2d5285;
    border: 1px solid #2d5285;
    color: #f7f3e8;
  }

  .svp-primary:hover {
    background: #24426b;
    border-color: #24426b;
  }

  .svp-secondary {
    background: transparent;
    border: 1px solid #c9bfa8;
    color: var(--foreground, #23201c);
  }

  .svp-secondary:hover {
    border-color: var(--border-strong, #a79f8f);
  }

  body.svp-lock {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .svp,
    .svp-card {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const KEY = "mt_simple_prompt_v1";
  const root = document.getElementById("simple-prompt") as HTMLElement | null;

  if (root) {
    let seen = false;
    try {
      seen = window.localStorage.getItem(KEY) === "seen";
    } catch {
      seen = true;
    }

    if (!seen) {
      const card = root.querySelector(".svp-card");
      let closeTimer: number | undefined;

      const close = () => {
        try {
          window.localStorage.setItem(KEY, "seen");
        } catch {
          /* storage blocked, nothing to remember */
        }
        root.classList.remove("is-open");
        document.body.classList.remove("svp-lock");
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          root.hidden = true;
        }, 180);
      };

      const open = () => {
        root.hidden = false;
        document.body.classList.add("svp-lock");
        requestAnimationFrame(() => {
          root.classList.add("is-open");
          (root.querySelector(".svp-primary") as HTMLElement | null)?.focus({
            preventScroll: true,
          });
        });
      };

      root.addEventListener("click", event => {
        if (event.target === root) close();
      });

      root.querySelectorAll("[data-svp-close]").forEach(button => {
        button.addEventListener("click", close);
      });

      document.addEventListener("keydown", event => {
        if (event.key === "Escape" && !root.hidden) close();
      });

      // keep tab focus inside the dialog while it is open
      root.addEventListener("keydown", event => {
        if (event.key !== "Tab") return;
        const focusable = root.querySelectorAll<HTMLElement>("a[href], button:not([disabled])");
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      card?.addEventListener("click", event => event.stopPropagation());

      window.setTimeout(open, 700);
    }
  }
</script>
