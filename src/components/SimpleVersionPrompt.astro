---
// First-visit prompt that points readers to the minimal version of the site.
// Shown once per browser, remembered in localStorage.
---

<div id="simple-prompt" class="svp" hidden>
  <div class="svp-card" role="dialog" aria-modal="true" aria-labelledby="svp-title">
    <p class="svp-kicker">Two versions</p>
    <h2 id="svp-title">A simpler version of this site</h2>
    <p>
      Same notes, fewer effects, easier to read. I publish there first, so it usually has the
      newest writing.
    </p>
    <p class="svp-note">Both versions stay in sync. Pick whichever reads better for you.</p>
    <div class="svp-actions">
      <a class="svp-primary" href="/all-about-me">
        Open the simple version <span aria-hidden="true">&rarr;</span>
      </a>
      <button class="svp-secondary" type="button" data-svp-close>Stay here</button>
    </div>
  </div>
</div>

<style>
  .svp {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(35, 32, 28, 0.38);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .svp.is-open {
    opacity: 1;
  }

  .svp-card {
    width: min(452px, 100%);
    padding: 26px 28px 24px;
    background: #f7f2e4;
    border: 1px solid var(--border, #d3c9b1);
    border-radius: 4px;
    box-shadow: 0 24px 60px -24px rgba(53, 40, 25, 0.45);
    color: var(--foreground, #23201c);
    transform: translateY(8px);
    transition: transform 160ms ease;
  }

  .svp.is-open .svp-card {
    transform: translateY(0);
  }

  .svp-kicker {
    margin: 0 0 10px;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--subtle-foreground, #8f8777);
  }

  .svp-card h2 {
    margin: 0 0 12px;
    font-size: 1.32rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .svp-card p {
    margin: 0 0 10px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted-foreground, #6e6a5f);
  }

  .svp-note {
    font-size: 0.88rem !important;
    color: var(--subtle-foreground, #8f8777) !important;
  }

  .svp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }

  .svp-primary,
  .svp-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 3px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .svp-primary {
    background: #1f6b45;
    border: 1px solid #1f6b45;
    color: #f7f3e8;
  }

  .svp-primary:hover {
    background: #175336;
    border-color: #175336;
  }

  .svp-secondary {
    background: transparent;
    border: 1px solid #c9bfa8;
    color: var(--foreground, #23201c);
  }

  .svp-secondary:hover {
    border-color: var(--border-strong, #a79f8f);
  }

  body.svp-lock {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .svp,
    .svp-card {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const KEY = "mt_simple_prompt_v1";
  const root = document.getElementById("simple-prompt") as HTMLElement | null;

  if (root) {
    let seen = false;
    try {
      seen = window.localStorage.getItem(KEY) === "seen";
    } catch {
      seen = true;
    }

    if (!seen) {
      const card = root.querySelector(".svp-card");
      let closeTimer: number | undefined;

      const close = () => {
        try {
          window.localStorage.setItem(KEY, "seen");
        } catch {
          /* storage blocked, nothing to remember */
        }
        root.classList.remove("is-open");
        document.body.classList.remove("svp-lock");
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          root.hidden = true;
        }, 180);
      };

      const open = () => {
        root.hidden = false;
        document.body.classList.add("svp-lock");
        requestAnimationFrame(() => {
          root.classList.add("is-open");
          (root.querySelector(".svp-primary") as HTMLElement | null)?.focus({
            preventScroll: true,
          });
        });
      };

      root.addEventListener("click", event => {
        if (event.target === root) close();
      });

      root.querySelectorAll("[data-svp-close]").forEach(button => {
        button.addEventListener("click", close);
      });

      document.addEventListener("keydown", event => {
        if (event.key === "Escape" && !root.hidden) close();
      });

      // keep focus inside the dialog while it is open
      root.addEventListener("keydown", event => {
        if (event.key !== "Tab") return;
        const focusable = root.querySelectorAll<HTMLElement>(
          "a[href], button:not([disabled])"
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      card?.addEventListener("click", event => event.stopPropagation());

      window.setTimeout(open, 700);
    }
  }
</script>
