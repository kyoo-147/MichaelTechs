    value: "github.com/kyoo-147",
    href: CONTACT.github,
  },
  {
    label: copy.linkedin,
    value: "michaelbui-engineer",
    href: CONTACT.linkedin,
  },
  {
    label: copy.x,
    value: "x.com/mih_cuog",
    href: CONTACT.x,
  },
  {
    label: copy.youtube,
