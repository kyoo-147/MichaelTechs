---
import { CONTACT } from "@/consts";

const title = "Michael Bui";
const description = "Michael Bui is an AI Research & Product Engineer and founder building practical AI systems, products, and software.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Michael Bui" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href="https://michaeltechs.xyz/all-about-me" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=mc" />
  </head>
  <body>
    <aside class="section-nav" aria-label="Page sections">
      <strong>Michael Bui</strong>
      <a href="#about">About</a>
      <a href="#focus">Current focus</a>
      <a href="#projects">Projects</a>
      <a href="#papers">Papers</a>
      <a href="#awards">Awards</a>
      <a href="#writing">Writing</a>
      <a href="#bookshelf">Bookshelf</a>
      <a href="#gallery">Gallery</a>
      <a href="#links">Links</a>
      <a href="#misc">Misc unsorted</a>
    </aside>

    <main id="about" data-pagefind-body>
      <h1>Michael Bui / Cuong Minh Bui</h1>

      <img
        class="portrait"
        src="/assets/all-about-me/michael.webp"
        width="140"
        height="140"
        alt="Michael Bui"
        decoding="sync"
        fetchpriority="high"
      />

      <section>
        <div class="heading-line">
          <h2>Contact</h2>
          <p>If you are interested in a fuller website about me, visit <a href="/">my main website</a>.</p>
        </div>
        <ul>
          <li><a href={CONTACT.github} rel="me">kyoo-147</a> on GitHub</li>
          <li><a href={CONTACT.linkedin} rel="me">Michael Bui</a> on LinkedIn</li>
          <li><a href={CONTACT.x} rel="me">@mih_cuog</a> on X</li>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> via email</li>
        </ul>
      </section>

      <section>
        <h2>Interests</h2>
        <p>
          I love to build practical and useful AI systems and products, and to train models that
          can learn, adapt, and work reliably in the real world. I am especially interested in
          foundation models, model research, machine learning, computer vision, speech, AI agents,
          embedded AI, automation, developer tools, and human-centered technology. I also enjoy
          books, drawing, physics, science, robotics, engines, and space. I sometimes
          <a href="/posts">write about what I learn</a>.
        </p>
      </section>

      <section id="focus">
        <h2>Current focus</h2>
        <ul>
          <li>
            Building useful AI for industry. Working on computer vision, intelligent automation,
            and real-world AI systems, including an automated pharmaceutical quality-control
            system at Dynamic Industrial Equipment Company Limited.
          </li>
          <li>
            At <a href="https://navinresearch.com">Navin Research</a>, we build and study useful
            AI: models, agents, computer vision, autonomous systems, and AI products designed to be
            more efficient, approachable, and adaptable to people and real environments.
          </li>
          <li>
            Our current direction is to train and experiment with foundation and frontier AI
            models across language, speech, and vision. The ambition is to build useful models that
            adapt well, open new technical possibilities, and contribute original work from
            Vietnam to the global AI community.
          </li>
        </ul>
      </section>

      <section id="projects">
        <h2>Projects</h2>
        <ul>
          <li>
            <a href="https://github.com/kyoo-147/SandoraAgent-CLI">Sandora Agent CLI</a>: a
            terminal-first autonomous coding and research agent with owned sessions, tools,
            delegation, approvals, and recoverable worktrees.
          </li>
          <li>
            <a href="https://github.com/kyoo-147/HowHow-Reasoner">HowHow Reasoner</a>: an
            evidence-first research operating system designed to move from a bounded question to
            inspectable experiments and a human-reviewable research package.
          </li>
          <li>
            <a href="https://github.com/kyoo-147/Sori">Sori</a>: a Windows-first, local-first
            programmable voice runtime for fast dictation, voice editing, and permission-gated
            actions.
          </li>
          <li>
            <a href="https://github.com/kyoo-147/Jobs_Radar">Jobs Radar</a>: a local-first search
            engine for remote jobs and freelance work, built around transparent sources and
            explicit user approval.
          </li>
          <li>
            <a href="https://github.com/kyoo-147/Writing_Machine">Writing Machine</a>: a
            source-backed AI research and production workflow for human-reviewed, upload-ready
            social content.
          </li>
          <li>
            <a href="https://github.com/kyoo-147/Ann">Ann / SignFlow</a>: a hybrid system that
            turns ASL recognition evidence into inspectable gloss, controlled English candidates,
            optional Vietnamese translation, speech, and correction feedback.
          </li>
          <li>
            <a href="/work/together-working">Together Working</a>: a local control plane for
            coordinating coding agents, task contracts, approvals, and verification gates.
          </li>
          <li>
            <a href="/work/dossier">Dossier</a>: document intelligence for PDFs, scans, forms,
            tables, handwriting, validation, and human review.
          </li>
          <li>
            <a href="/work/workwise">WorkWise</a>: an AI-assisted workflow control layer for
            operational requests involving money, risk, policy, and approvals.
          </li>
          <li>
            <a href="/work/everdock-desktop">EverDock Desktop</a>: a desktop control plane for AI
            coding agents running locally, over SSH, and on managed servers.
          </li>
          <li>
            <a href="/work/sandora">Sandora</a>: a platform for configuring multi-agent teams,
            departments, tools, workflows, approval gates, and audit logs.
          </li>
          <li>
            <a href="/work/moyi-edge-translation">MoYi Edge Translation</a>: edge-first,
            privacy-aware translation infrastructure for factories and multilingual operations.
          </li>
          <li>
            <a href="/work/snow-ai-companion">Snow AI Companion</a>: a child-safe AI companion
            focused on controlled conversation, routine support, and parent oversight.
          </li>
          <li>
            <a href="/work/oneclick-crm">YI-OneClick</a>: an AI-assisted CRM and workflow platform
            for leads, customers, deals, quotations, follow-ups, and business operations.
          </li>
          <li>
            <a href="/work/autonomous-vehicle-research">Autopilot &amp; FSD — BFMC</a>: a scale-model
            autonomous vehicle combining perception, planning, control, and embedded AI. I led the
            2024–2025 team.
          </li>
          <li>
            <a href="/work/computer-vision-qc-system">Pharmaceutical QC Defect Detection Machine</a>:
            an industrial vision project covering data collection, defect design, training,
            validation, cameras, industrial PCs, and edge deployment. I worked as Project Manager.
          </li>
          <li>
            <a href="/work/maritime-vms">Maritime VMS Management System</a>: a vessel operations
            system for satellite connectivity, bandwidth control, GPS data, and operational
            visibility.
          </li>
          <li>
            <a href="/work/gardon">Gardon SmartThinks</a>: an archived smart-garden system using
            ESP32, MQTT, web and mobile applications, and a local voice assistant.
          </li>
          <li>
            <a href="/work/dotx-aero">DotX Aero</a>: an archived local-first smart-home voice and
            IoT architecture using Vietnamese speech, local models, MQTT, and ESP32 devices.
          </li>
          <li>
            <a href="/work/travel-booking-agent">Travel Booking Agent</a>: an archived travel
            planning system using microservices, retrieval, memory, search, and automated hotel
            communication.
          </li>
          <li>
            <a href="/work/safex">SafeX</a>: an archived real-time computer-vision security and
            attendance project.
          </li>
          <li>
            <a href="/work/rabbit-signlink">Rabbit SignLink</a>: an archived sign-language learning
            and recognition prototype for accessibility research.
          </li>
        </ul>
        <p>
          This list is now very outdated :). See my up-to-date projects on
          <a href={CONTACT.github}>GitHub</a>.
        </p>
      </section>

      <section id="papers">
        <h2>Papers</h2>
        <p class="small-note">I will update this section in the future.</p>
      </section>

      <section id="awards">
        <h2>Awards</h2>
        <ul>
          <li>
            BFMC 2024 — Team Lead for the Vietnamese team, ranked Top 15 worldwide and selected for
            the final in Romania; physical participation was prevented by visa issues.
          </li>
        </ul>
        <p class="small-note">I will add more here soon.</p>
      </section>

      <section id="writing">
        <h2>Writing</h2>
        <p>I write technical notes, project reflections, and research explainers.</p>
        <ul>
          <li><a href="/posts/building-practical-ai-systems">Building Practical AI Systems</a></li>
          <li>
            <a href="/posts/beyond-bigger-models-ai-research">Beyond Bigger Models: New Directions
              in AI Model Research</a>
          </li>
          <li><a href="/posts/kimi-k3-explained">Kimi K3 Explained</a></li>
          <li>
            <a href="/posts/ai-engineer-business-workflow">Why AI Engineers Need to Understand
              Business Workflows, Not Just Models</a>
          </li>
          <li><a href="/posts">All writing</a></li>
        </ul>
      </section>

      <section id="bookshelf">
        <h2>Bookshelf</h2>
        <p>
          I read across AI, hard science fiction, physics, philosophy, history, and the craft of
          building. My list remains unfinished because many books are still in storage.
          <a href="/posts/books-that-shaped-the-way-i-think">See my current reading list</a>.
        </p>
      </section>

      <section id="gallery">
        <h2>Gallery</h2>
        <p>
          A small visual archive of drawings, photographs, personal work, and moments outside
          engineering. <a href="/gallery">Open the gallery</a>.
        </p>
      </section>

      <section id="links">
        <h2>Elsewhere</h2>
        <ul>
          <li><a href="/">Full portfolio</a></li>
          <li><a href="/work">Work archive</a></li>
          <li><a href="/gallery">Personal gallery</a></li>
          <li><a href="/Founder_BuiMinhCuong.pdf">Résumé (PDF)</a></li>
          <li><a href={CONTACT.youtube}>YouTube</a></li>
        </ul>
      </section>

      <section id="misc">
        <h2>Misc unsorted</h2>
        <ul>
          <li>
            This page ships as plain static HTML and CSS with no client-side JavaScript because I
            am becoming seriously allergic to 500-pound websites. It is part of the existing Astro
            build, rather than pretending the rest of the site has no framework. See also:
            <a href="https://motherfuckingwebsite.com/">motherfuckingwebsite.com</a>.
          </li>
          <li>
            I like hard science fiction, especially stories built around technical ideas,
            world-building, physics, future forecasting, and artificial intelligence. I listed
            some of the books that have shaped how I think
            <a href="/posts/books-that-shaped-the-way-i-think">here</a>.
          </li>
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  html { background: #686868; }
  main, .section-nav { box-sizing: border-box; }
  body { margin: 0; color: #000; font-family: "Times New Roman", Times, serif; font-size: 17px; line-height: 1.35; }
  main { width: min(1056px, calc(100% - 64px)); min-height: calc(100vh - 30px); margin: 15px auto 0; padding: 18px 32px 48px; background: #fff; }
  .section-nav { position: fixed; top: 32px; left: max(16px, calc(50% - 760px)); width: 150px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.08; text-align: right; }
  .section-nav strong, .section-nav a { display: block; }
  .section-nav strong { margin-bottom: 3px; color: #fff; font-weight: 400; }
  .section-nav a { color: #fff; }
  h1 { margin: 0 0 16px; font-size: 36px; line-height: 1.1; }
  h2 { margin: 18px 0 12px; font-size: 28px; line-height: 1.15; }
  p { margin: 0 0 14px; }
  ul { margin: 0 0 16px; padding-left: 40px; }
  li { margin: 4px 0; }
  a { color: #0000ee; }
  .portrait { float: right; width: 140px; height: 140px; margin: 0 0 24px 40px; object-fit: cover; }
  .heading-line { display: flex; align-items: baseline; gap: 18px; }
  .heading-line h2 { flex: none; }
  .heading-line p, .small-note { font-size: 14px; }
  .heading-line p { margin: 0; }

  @media (max-width: 1360px) {
    .section-nav { position: static; width: min(1056px, calc(100% - 64px)); margin: 15px auto 0; padding: 10px 32px; background: #fff; text-align: left; line-height: 1.35; }
    .section-nav strong, .section-nav a { display: inline; margin-right: 12px; color: #000; }
    .section-nav a { color: #0000ee; }
    main { margin-top: 0; }
  }

  @media (max-width: 640px) {
    html { background: #fff; }
    body { font-size: 16px; }
    main { width: 100%; min-height: 100vh; margin: 0; padding: 18px 16px 40px; }
    .section-nav { width: 100%; margin: 0; padding: 12px 16px 4px; }
    .section-nav strong { display: block; margin-bottom: 5px; }
    .section-nav a { display: inline-block; margin-bottom: 4px; }
    h1 { font-size: 32px; }
    h2 { font-size: 25px; }
    ul { padding-left: 28px; }
    .portrait { width: 112px; height: 112px; margin-left: 20px; }
    .heading-line { display: block; }
    .heading-line p { margin: -6px 0 12px; }
  }

  @media print {
    html { background: #fff; }
    main { width: 100%; margin: 0; padding: 0; }
    .section-nav { display: none; }
  }
</style>
