[Unit]
Description=Build privacy-preserving Michael visitor aggregates
ConditionPathExists=/var/lib/michael-analytics/DBIP-City-Lite.mmdb
ConditionPathExists=/var/log/nginx/michaeltechs.access.log
ConditionPathExists=/opt/michael-analytics/.venv/bin/python
ConditionPathExists=/opt/michael-analytics/run-production.sh

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
WorkingDirectory=/opt/michael-analytics
ExecStart=/opt/michael-analytics/run-production.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/var/lib/michael-analytics
